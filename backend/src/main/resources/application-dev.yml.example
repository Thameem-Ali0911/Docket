spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/docket
    username: postgres
    password: root
  jpa:
    hibernate:
      ddl-auto: none
    show-sql: true
    properties:
      hibernate:
        format_sql: true
  flyway:
    enabled: true
    locations: classpath:db/migration
    clean-disabled: true
jwt:
  secret: your-jwt-secret-here
gemini:
  api-key: your-gemini-api-key-here
