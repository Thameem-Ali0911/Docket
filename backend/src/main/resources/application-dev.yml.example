spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/docket
    username: postgres
    password: password
  jpa:
    hibernate:
      ddl-auto: none
    show-sql: true
    properties:
      hibernate:
        format_sql: true
flyway:
  enabled: true
  locations: classpath:db/migration
jwt:
  secret: your-jwt-secret-here
anthropic:
  api-key: your-anthropic-api-key-here
