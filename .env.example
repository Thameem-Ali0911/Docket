# ==============================================================================
# Docket Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` (for Docker Compose / local dev) or configure these
# variables in your cloud hosting provider (Render, Railway, Fly.io, Vercel).
# NEVER commit the actual `.env` file containing secrets to version control.
# ==============================================================================

# Database Configuration (PostgreSQL 16+)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=docket
# Host & port when connecting outside docker compose (e.g., local spring boot run):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/docket

# Authentication & Security
# Generate a cryptographically secure key in production (e.g. `openssl rand -base64 64`)
JWT_SECRET=dev-only-insecure-secret-change-me-to-a-secure-random-64-character-string

# AI / LLM Engine (Google Gemini)
# Obtain a free key from: https://aistudio.google.com/apikey
# If left blank, pre-seeded documents and OCR still function, but live LLM extraction is bypassed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Storage Configuration
STORAGE_UPLOAD_DIR=/app/uploads

# Observability & Debugging
SHOW_SQL=false
FORMAT_SQL=false

# Document Processing Mode (Phase 12.3)
# "async" = Spring @Async thread pool (no RabbitMQ needed, default for local dev)
# "queue" = RabbitMQ message queue (used in Docker Compose, requires broker)
PROCESSING_MODE=async

# RabbitMQ Configuration (only required when PROCESSING_MODE=queue)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Frontend Configuration (Browser-Facing URL)
# For local Docker Compose: http://localhost:8080
# For Production / Hosted: https://your-backend-api.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# Production Demo Credentials (Pre-seeded via Flyway V9)
# Email: demo@docket.ai
# Password: Demo1234!
