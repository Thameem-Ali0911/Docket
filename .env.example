# Copy to .env and fill in real values before running `docker compose up`.
# .env is git-ignored — never commit real secrets here.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

JWT_SECRET=change-me-to-a-long-random-string

# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Base URL the frontend bundle will call at runtime (browser-facing, not container-internal)
VITE_API_BASE_URL=http://localhost:8080
